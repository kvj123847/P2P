# Shared deployment and local development values.
# Copy the relevant values into the service-specific .env files and never commit real credentials.

CORE_API_URL=http://10.0.2.2:3000/api/v1
SESSION_ENGINE_URL=http://10.0.2.2:8001
P1_SERVICE_TOKEN=change_me_service_token_min_32_chars_long

# Render / Neon placeholders
DATABASE_URL=postgresql://postgres:postgres@host:5432/database?sslmode=require
DIRECT_URL=postgresql://postgres:postgres@host:5432/database?sslmode=require
CORE_API_BASE_URL=https://api.example.com/api/v1
SESSION_ENGINE_BASE_URL=https://session.example.com
CLIENT_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com,http://localhost:3000,http://localhost:3001

# Agora placeholders
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=replace_with_your_agora_app_certificate

