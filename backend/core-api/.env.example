# =============================================================================
# P2P Learning Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_VERSION=v1
P1_SERVICE_TOKEN=change_me_service_token_min_32_chars_long
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://app.example.com,https://admin.example.com

# ---------------------------------------------------------------------------
# Database  (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/p2p_learning_dev"

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Apple Sign-In
# ---------------------------------------------------------------------------
APPLE_CLIENT_ID=com.yourapp.bundle
APPLE_TEAM_ID=YOURTEAMID
APPLE_KEY_ID=YOURKEYID
APPLE_PRIVATE_KEY_PATH=./certs/AuthKey_YOURKEYID.p8
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# ---------------------------------------------------------------------------
# Explicit demo-only payment and notification mode
# ---------------------------------------------------------------------------
MOCK_SERVICES_ENABLED=false
MOCK_DEMO_MODE=false
MOCK_PAYMENT_ADMIN_TOKEN=change_me_mock_payment_admin_token_min_32_chars

# ---------------------------------------------------------------------------
# SendGrid (transactional email)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourapp.com

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Redis  (optional — enables distributed rate limiting & token blacklisting)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
